    "#Creating the prompt, with the user questions and the tables definitions.\n",
    "# --- Cell: Build prompt from table definitions + user question, call the model, extract SQL ---\n",
    "\n",
    "import re\n",
    "\n",
    "# 1) Turn your df (table, definition) into a compact text block the model can read\n",
    "#    Example line: \"- students: student_id (PK), name, age, major\"\n",
    "text_tables = \"\\n\".join(f\"- {row.table}: {row.definition}\" for _, row in df.iterrows())\n",
    "\n",
    "# 2) A prompt template that tells the model exactly what to do\n",
    "prompt_question_tables = (\n",
    "    \"You are a senior SQL assistant.\\n\"\n",
    "    \"Given ONLY the following tables and short definitions, write ONE SQL query that answers the user's question.\\n\"\n",
    "    \"Rules:\\n\"\n",
    "    \" - Use ONLY the listed tables and columns; do NOT invent tables/columns.\\n\"\n",
    "    \" - Prefer ANSI JOINs.\\n\"\n",
    "    \" - Return ONLY the SQL inside a single code block (```sql ... ```). No extra text.\\n\\n\"\n",
    "    \"Tables:\\n{tables}\\n\\n\"\n",
    "    \"User question:\\n{question}\\n\"\n",
    ")\n",
    "\n",
    "# 3) Provide your natural language question here\n",
    "user_query = \"List the names of students older than 20 who are enrolled in 'Math 101'.\"\n",
    "\n",
    "# 4) Fill the template\n",
    "pqt1 = prompt_question_tables.format(tables=text_tables, question=user_query)\n",
    "\n",
    "# 5) Call the model\n",
    "messages = [\n",
    "    {\"role\": \"system\", \"content\": \"You write precise SQL for the specified dialect. Do not hallucinate schema.\"},\n",
    "    {\"role\": \"user\", \"content\": pqt1},\n",
    "]\n",
    "resp = client.chat.completions.create(\n",
    "    model=\"gpt-3.5-turbo\",\n",
    "    messages=messages,\n",
    "    temperature=0,\n",
    ")\n",
    "\n",
    "# 6) Extract SQL from the code block (fallback: raw text)\n",
    "raw_out = resp.choices[0].message.content\n",
    "m = re.search(r\"```sql\\s*(.*?)```\", raw_out, flags=re.DOTALL | re.IGNORECASE)\n",
    "generated_sql = m.group(1).strip() if m else raw_out.strip()\n",
    "\n",
    "print(\"=== GENERATED SQL ===\")\n",
    "print(generated_sql)\n"
