    "# --- A) Ask the model to select relevant tables (returns a Python list) ---\n",
    "def select_relevant_tables(user_question, tables_text):\n",
    "    sys = (\n",
    "        \"You select relevant SQL tables only. \"\n",
    "        \"Return ONLY a pure JSON array of table names (e.g., [\\\"students\\\",\\\"enrollments\\\"]). \"\n",
    "        \"No prose, no code fences.\"\n",
    "    )\n",
    "    template = f\"\"\"\n",
    "Given the following tables and their content definitions,\n",
    "\n",
    "### Tables\n",
    "{tables_text}\n",
    "\n",
    "Tell me which tables would be necessary to query with SQL to address the user's question below.\n",
    "Return ONLY the table names in a pure JSON array (no prose, no code fences).\n",
    "\n",
    "### User Question\n",
    "{user_question}\n",
    "\"\"\".strip()\n",
    "\n",
    "    resp = client.chat.completions.create(\n",
    "        model=\"gpt-3.5-turbo\",\n",
    "        messages=[{\"role\":\"system\",\"content\":sys},\n",
    "                  {\"role\":\"user\",\"content\":template}],\n",
    "        temperature=0,\n",
    "    )\n",
    "    raw = resp.choices[0].message.content.strip()\n",
    "    m = re.search(r\"\\[.*?\\]\", raw, flags=re.DOTALL)\n",
    "    if not m:\n",
    "        return []  # fallback\n",
    "    try:\n",
    "        return json.loads(m.group(0))\n",
    "    except json.JSONDecodeError:\n",
    "        return []\n",
    "\n",
    "# --- B) Generate SQL from (subset) schema + question ---\n",
    "def generate_sql(user_question, selected_tables, df_schema, dialect=\"sqlite\"):\n",
    "    # Build a catalog limited to selected tables\n",
    "    schema_map = dict(zip(df_schema[\"table\"], df_schema[\"definition\"]))\n",
    "    catalog = \"\\n\".join(f\"- {t}: {schema_map[t]}\" for t in selected_tables if t in schema_map)\n",
    "\n",
    "    sys = (\n",
    "        \"You are a senior SQL engineer. \"\n",
    "        f\"Write ONE {dialect} SQL query that answers the question using ONLY the provided tables/columns. \"\n",
    "        \"Use explicit JOINs; do not invent tables or columns. \"\n",
    "        \"Return ONLY the SQL inside ```sql ... ```.\"\n",
    "    )\n",
    "    user = f\"Question: {user_question}\\n\\nUse ONLY these tables & columns:\\n{catalog}\"\n",
    "\n",
    "    resp = client.chat.completions.create(\n",
    "        model=\"gpt-3.5-turbo\",\n",
    "        messages=[{\"role\":\"system\",\"content\":sys},\n",
    "                  {\"role\":\"user\",\"content\":user}],\n",
    "        temperature=0,\n",
    "    )\n",
    "    out = resp.choices[0].message.content\n",
    "    m = re.search(r\"```sql\\s*(.*?)```\", out, flags=re.DOTALL|re.IGNORECASE)\n",
    "    return (m.group(1).strip() if m else out.strip())\n"
   ]
